<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>God2Iso</RootNamespace>
    <AssemblyName>God2Iso</AssemblyName>
    <Version>3.0.0</Version>
    <ApplicationIcon>Tribalmarkings-Colorflow-Xbox-360.ico</ApplicationIcon>
    <StartupObject>God2Iso.Program</StartupObject>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="XSFHeader.bin" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Tribalmarkings-Colorflow-Xbox-360.ico" />
  </ItemGroup>

</Project>
